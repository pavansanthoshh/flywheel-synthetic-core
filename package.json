{
  "name": "@flywheel/synthetic-core",
  "version": "0.1.0",
  "description": "Guarded synthetic monitoring, Claude-powered RCA, validated patches and draft PRs",
  "type": "module",
  "private": false,
  "license": "MIT",
  "engines": { "node": ">=22" },
  "files": ["dist", "bin", "README.md", "LICENSE"],
  "bin": { "flywheel": "./bin/flywheel.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/__tests__/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "playwright": "1.64.1",
    "zod": "4.6.5",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.16.0"
  }
}
